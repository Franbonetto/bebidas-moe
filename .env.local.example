NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional, solo desarrollo: IP de esta maquina en la red local, para
# poder abrir la app desde el celular (next dev -H 0.0.0.0).
DEV_ORIGEN_LAN=

# PIN de operaciones sensibles (entrada de mercaderia, ajuste de stock,
# precios, promociones, carga inicial). Ver lib/pin.ts. Si falta, esas
# pantallas no dejan confirmar. El valor real NO va en este archivo.
PIN_OPERACIONES=

# Telefono del dueno para el boton "Enviar al dueno por WhatsApp" del
# ticket de cierre de caja. Dato personal: el numero real NO va en este
# archivo ni en el repo. Se acepta 2284562976, +54 9 2284 56-2976 o
# 5492284562976 -- lib/whatsapp.ts lo normaliza. Si falta, el boton no
# aparece.
WHATSAPP_DUENO=
